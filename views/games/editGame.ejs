<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= title %></title>
</head>
<body>
  <div id="create-game">
    <form action="/games/<%= game.id %>/edit" method="post">
      <h1>Edit game info</h1>
      <label>Title: 
        <input type="text" name="title" id="title" value="<%= game.title %>" required />
      </label>
      <label>Date of release:
        <input type="date" name="release_date" id="release_date" value="<%= game.release_date.toISOString().substring(0, 10) %>" required />
      </label>
      <label>Publisher:
        <input type="text" name="publisher" id="publisher" value="<%= game.publisher %>" required />
      </label>
      <label>Developer:
        <input type="text" name="developer" id="developer" value="<%= game.developer %>" required/>
      </label>
      <label>Genre:
        <input type="text" name="genre" id="genre" value="<%= game.genre %>" required/>
      </label>
      <%- include("../error") %>
      <div>
        <button type="submit">save</button>
        <button type="reset">reset</button>
         <a href="/games">Cancel</a>
      </div>
    </form>
  </div>
</body>
</html>