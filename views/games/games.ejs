<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
</head>
<body>
  <%- include("../navBar", { links: links }) %>

  <div>
    <h1><%= title %></h1>
    <!-- <button type="button" id="add-game-btn" onclick=<%= locals.openDialog %> >add game</button> -->
    <a href="/games/new">add game</a>
    <%# include("createGame") %>
    <ul>
      <% if (locals.games) { %>
        <% games.forEach(function(game) { %>
          <li>
            Game: <%= game.title %>
            <a href="/games/<%= game.id %>/edit">edit</a>
            <form action="/games/<%= game.id %>/delete" method="POST">
              <button type="submit" onclick="return confirm('Are you sure you want to delete this game?');" >Delete</button>
            </form>
          </li>

        <% }); %>
      <% } %>
    </ul>
  </div>

</body>
</html>