<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
</head>
<body>
  <div id="create-list">
    <form action="/lists/<%= list.id %>/edit" method="post">
      <p>Edit <%= list.name %> list info</p>
      <label>List name: 
        <input type="text" name="name" id="name" value="<%= list.name %>" required/>
      </label>
      <label>List description: 
        <textarea name="description" id="description" cols="50" rows="9"><%= list.description %></textarea>        
      </label>
      <%- include("../error") %>
      <button type="submit">save</button>
      <button type="reset">reset</button>
      <a href="/lists">Cancel</a>
    </form>
  </div>
</body>
</html>