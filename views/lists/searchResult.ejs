

<% if (locals.result) {%>
  
  <!-- <h2>Games</h2> -->
  <ul>
    <% result.forEach(function(r) { %>
      <li>
        <form action="./<%= r.id %>/add" method="post" style="display:inline;">
          <button  type="submit" onclick="return confirm('Are you sure you want to add this game?');">add</button>
        </form>
        <%= r.title %> | <%= r.developer %>
      </li>
    <% }) %>
  </ul>
  <hr/>
<% } %> 