<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
</head>
<body>
  <div>
    <h1><%= list.name %></h1>
    <p><%= list.description %></p>

    <div class="game-list">
      <form action="" method="get" >
        <label>Search for game title: 
          <input type="search" name="query" id="query">
        </label>
        <button type="submit">search</button>
      </form>
      <%- include("searchResult") %>
      <ul>
        <h2>Games:</h2>
        <% if (locals.games) { %>
          <% games.forEach(function(game) { %>
            <%# console.log(game) %>
            <li><%= game["game_title"] %></li>
          <% }) %>
        <% } %>
      </ul>
    </div>
    <a href="/lists">Back</a>
  </div>
</body>
</html>