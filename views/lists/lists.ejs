<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
</head>
<body>
  <%- include("../navBar", { links: links }) %>

  <div>
    <h1><%= title %></h1>
    <a href="/lists/new">create list</a>
    <!-- <%# include("createGame") %> -->
    <ul>
      <% if (locals.lists) { %>
        <% lists.forEach(function(list) { %>
          <li>
            <h2><a href="/lists/<%= list.id %>/<%= list.name %>/info/"><%= list.name %></a></h2>
            <p><%= list.description %></p>
            <a href="/lists/<%= list.id %>/edit">edit</a>
            <form action="/lists/<%= list.id %>/delete" method="POST">
              <button type="submit" onclick="return confirm('Are you sure you want to delete this list?');" >Delete</button>
            </form>
          </li>

        <% }); %>
      <% } %>
    </ul>
  </div>

</body>
</html>